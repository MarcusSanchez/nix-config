// Zed settings — macOS port of the WSL copy (home/marcus/wsl/zed/settings.json,
// the tuned source of truth). Keep them in sync by diffing against it.
//
// Deltas from the WSL original:
//   1. "wsl_connections" dropped (WSL-only — Zed here opens ~ paths directly).
//   2. "proxy" dropped (empty Windows leftover).
// Everything else (semantic tokens, GoLand theme port, gopls, vim setup) is
// platform-neutral and intentionally identical.
{
  "cli_default_open_behavior": "existing_window",
  "agent_ui_font_size": 16.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "terminal": {
    "font_size": 14.0
  },
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 300
    }
  },
  "semantic_tokens": "combined",
  "global_lsp_settings": {
    // first match wins. GoLand truth: const locals and module-level
    // consts (STORE_URL) plain; stdlib builtins (Go nil/iota) peach à la
    // GO_BUILTIN_VARIABLE; whatever remains without modifiers is a true
    // global (__DEV__, ambient) → DEFAULT_GLOBAL_VARIABLE red
    "semantic_token_rules": [
      {
        "token_type": "variable",
        "token_modifiers": ["readonly", "local"],
        "style": ["variable"]
      },
      {
        "token_type": "variable",
        "token_modifiers": ["readonly", "defaultLibrary"],
        "style": ["constant"]
      },
      {
        "token_type": "variable",
        "token_modifiers": ["readonly"],
        "style": ["variable"]
      },
      {
        "token_type": "variable",
        "token_modifiers": ["local"],
        "style": ["variable"]
      },
      {
        "token_type": "variable",
        "foreground_color": "#f38ba8"
      },
      {
        "token_type": "enumMember",
        "style": ["enum", "constant"]
      },
      {
        "token_type": "parameter",
        "style": ["variable.parameter", "attribute"]
      }
    ]
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        // match nvim (LazyVim lang.go: goimports+gofumpt) and goland:
        // stricter formatting incl. stdlib imports as their own group
        "gofumpt": true
      }
    }
  },
  "languages": {
    "Zig": {
      "tab_size": 4
    },
    "Nix": {
      // nixd comes from the system config on both machines; the
      // extension's auto-downloaded nil binary is unnecessary
      "language_servers": ["nixd", "!nil"]
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
  },
  "enable_language_server": true,
  "edit_predictions": {
    "provider": "copilot",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "icon_theme": "Catppuccin Mocha",
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
    "cargo": null,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "tabs": {
    "file_icons": true,
  },
  "relative_line_numbers": "enabled",
  "base_keymap": "JetBrains",
  "vim_mode": true,
  // "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },

  "vertical_scroll_margin": 5,
  "scroll_beyond_last_line": "vertical_scroll_margin",

  "buffer_font_features": {
    "calt": false,
  },

  "extend_comment_on_newline": false,

  "preferred_line_length": 120,
  "wrap_guides": [120],

  // ported from GoLand's "M's Mocha" scheme (the source of truth for
  // syntax colors — AppData\Roaming\JetBrains\GoLand*\colors\M_s Mocha.icls).
  // Not expressible here: global-vs-local variables, exported-vs-local
  // constants (Zed's captures don't distinguish them)
  "experimental.theme_overrides": {
    // bracket-colorization cycle (colorize_brackets above), same colors
    // and order as GoLand's *_BRACKETS_RAINBOW_COLOR0-5
    "accents": [
      "#f9e2af",
      "#cba6f7",
      "#f38ba8",
      "#89b4fa",
      "#89dceb",
      "#fab387",
    ],
    "syntax": {
      "keyword": { "color": "#cba6f7", "font_style": "italic" },
      "function": { "color": "#89b4fa" },
      "function.builtin": { "color": "#89b4fa" },
      "type": { "color": "#f9e2af" },
      "type.builtin": { "color": "#cba6f7" },
      "constructor": { "color": "#f9e2af" },
      "enum": { "color": "#fab387" },
      "constant": { "color": "#fab387" },
      // true/false/null/undefined read as keywords in GoLand
      "boolean": { "color": "#cba6f7", "font_style": "italic" },
      "constant.builtin": { "color": "#cba6f7", "font_style": "italic" },
      "number": { "color": "#89dceb" },
      "property": { "color": "#f38ba8" },
      "field": { "color": "#f38ba8" },
      "variable.member": { "color": "#f38ba8" },
      "variable": { "color": "#bac2de" },
      "variable.parameter": { "color": "#dabb9b" },
      "attribute": { "color": "#dabb9b" },
      "namespace": { "color": "#bac2de", "font_style": "italic" },
      // GoLand: components yellow via class-reference resolution; Zed's
      // single tag capture can't split components from <div>s, so all
      // JSX tags go yellow
      "tag": { "color": "#f9e2af" },
      "operator": { "color": "#ff6ca9" },
      "punctuation.delimiter": { "color": "#9399b2" },
      "punctuation.bracket": { "color": "#9399b2" },
      "punctuation.special": { "color": "#ff6ca9" },
    },
  },
}
