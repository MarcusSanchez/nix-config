# The mocha mask: ghostty's shipped "Catppuccin Mocha" theme verbatim,
# MINUS its background line. Included by ghostty.linux.config AFTER the
# ryoku-colors include (deferred includes process in listed order), so
# every color the wallpaper palette wrote is re-asserted back to mocha
# except the background — the terminal's canvas follows the wallpaper,
# the text stays catppuccin. Refresh from share/ghostty/themes in the
# ghostty package if the theme ever changes.
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f37799
palette = 10=#89d88b
palette = 11=#ebd391
palette = 12=#74a8fc
palette = 13=#f2aede
palette = 14=#6bd7ca
palette = 15=#bac2de
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #585b70
selection-foreground = #cdd6f4
