# Ghostty on the mac — ~/.config/ghostty/config links here. The app
# itself is a brew cask (homebrew.nix); shaders stay an imperative
# folder in ~/Library/Application Support/com.mitchellh.ghostty.
config-file = ghostty.config

# ghostty's own bundled catppuccin port (themes ship in share/ghostty/
# themes, spaces in the name and all). Set in the ENTRY, not the shared
# base — the base is a deferred include and would override this line.
theme = Catppuccin Mocha

font-size = 16
# JetBrains-editor line spacing: the IDE multiplies the font's natural
# line height by 1.2, and ghostty's untouched cell IS that natural
# height, so 20% is the same pitch. A percentage so it tracks the font
# size (the entries own this — the base is a deferred include)
adjust-cell-height = 20%

macos-titlebar-style = tabs
# Open maximized. Not `window-height/width = 20000` — the oversized-size
# trick Ghostty documents as clamping to the screen: every surface runs
# the initial-size path, tabs included, and on macOS the requested grid
# becomes the content view's intrinsic size, laid out and allocated in
# full before the window is constrained to the screen.
maximize = true

background-blur = 20
