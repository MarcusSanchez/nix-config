# Ghostty on the mac — ~/.config/ghostty/config links here. The app
# itself is a brew cask (homebrew.nix); shaders stay an imperative
# folder in ~/Library/Application Support/com.mitchellh.ghostty.
config-file = ghostty.config

font-size = 17

macos-titlebar-style = tabs
# Open maximized. Not `window-height/width = 20000` — the oversized-size
# trick Ghostty documents as clamping to the screen. Every surface runs
# the initial-size path, tabs included, and on macOS the requested grid
# becomes the content view's intrinsic size, which is what gets laid out
# and allocated; the window is only constrained to the screen afterwards.
# At 20000 cells that is tens of GB per new tab, and the mac swaps itself
# to a standstill for half a minute.
maximize = true

background-blur = 20

# custom-shader = …/ghostty-shaders/starfield.glsl
