// Zed keymap — macOS port of the WSL copy (home/marcus/common/dotfiles/zed.keymap.json,
// the tuned source of truth; itself descended from this machine's pre-nix
// keymap). Keep them in sync by diffing against it.
//
// Deltas from the WSL original — mac-native chords ADDED alongside, never
// replacing, the shared ctrl- bindings, so WSL muscle memory works here too:
//   1. Terminal: "cmd-t" added next to "ctrl-t" (new terminal).
//   2. Terminal/Editor: "cmd-w" added next to "ctrl-w" (close tab).
//   3. ProjectPanel: "cmd-w" added next to "ctrl-w" (toggle dock) — the
//      pre-nix mac binding.
// Everything else (vim layer, alt- chords, # macro system, task keys) is
// platform-neutral and intentionally identical.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-:": "workspace::ToggleBottomDock",
      "alt-1": "workspace::ToggleRightDock",
      "shift shift": "file_finder::Toggle"
    }
  },

  {
    "context": "Terminal",
    "bindings": {
      "alt-:": "workspace::ToggleBottomDock",
      "escape": "workspace::ActivatePaneUp",
      "alt-l": "pane::ActivateNextItem",
      "alt-h": "pane::ActivatePreviousItem",
      "ctrl-t": "workspace::NewTerminal",
      "cmd-t": "workspace::NewTerminal",
      // close terminal tab (overrides forwarding ctrl-w to the shell;
      // ctrl-backspace still deletes a word)
      "ctrl-w": "pane::CloseActiveItem",
      "cmd-w": "pane::CloseActiveItem"
    }
  },

  {
    "context": "Editor",
    "bindings": {
      "ctrl-j": "editor::AddSelectionAbove",
      "ctrl-k": "editor::AddSelectionBelow",
      // close tab (overrides JetBrains extend-selection and vim insert-mode
      // delete-word)
      "ctrl-w": "pane::CloseActiveItem",
      "cmd-w": "pane::CloseActiveItem"
    }
  },

  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::SwitchToNormalMode"
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "j": "vim::Up",
      "k": "vim::Down",

      "shift-h": "vim::FirstNonWhitespace",
      "shift-l": "vim::EndOfLine",

      "shift-j": "vim::ScrollUp",
      "shift-k": "vim::ScrollDown",

      "g k": "editor::Hover",
      "g e": "editor::Hover",

      "e": "vim::NextWordStart",
      "b": "vim::NextWordEnd",
      "w": "vim::PreviousWordStart",

      // the same mirror one level up: ideavimrc's `noremap W B / E W / B E`.
      // ignore_punctuation is Zed's WORD variant — treats a punctuation-glued
      // token as one word, so it lands where vim's uppercase motions do. The
      // key is snake_case: the action SCHEMA spells it ignorePunctuation, but
      // the keymap parser wants ignore_punctuation, and the camelCase form is
      // accepted-then-ignored, silently giving you lowercase behaviour.
      "shift-w": ["vim::PreviousWordStart", { "ignore_punctuation": true }],
      "shift-e": ["vim::NextWordStart", { "ignore_punctuation": true }],
      "shift-b": ["vim::NextWordEnd", { "ignore_punctuation": true }],

      "alt-J": "editor::MoveLineUp",
      "alt-K": "editor::MoveLineDown",

      // Motions assigned for noremap like maps
      "# u": "vim::Up",
      "# v d l": "vim::VisualDeleteLine",
      "# p r": "vim::PushRegister",
      "# p d": "vim::PushDelete",
      "# d e o l": "vim::DeleteToEndOfLine"
    }
  },

  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      ", a": "project_panel::ToggleFocus",
      ", q": "pane::CloseActiveItem",
      ", g": "editor::ToggleCodeActions",
      // Close the side windows from the editor. NOT CloseActiveDock: that
      // one means the dock with FOCUS, so pressed from here — where the
      // editor has focus and no dock does — it silently no-ops. And not
      // ToggleAllDocks either: that reopens everything on a second press.
      // CloseAllDocks closes what is open and stays closed. Zed ships it
      // unbound; ToggleAllDocks is what its own defaults use.
      ", c": "workspace::CloseAllDocks",
      ", t": "terminal_panel::ToggleFocus",
      // autosave writes the buffer after the format edits land
      ", f": "editor::Format",
      // rerun last task / pick a task — the ideavimrc Run and
      // RunConfiguration equivalents
      ", r": "task::Rerun",
      ", x": "task::Spawn",
      ", p": "projects::OpenRecent",

      // _ register del line (delete without yanking)
      "d d": ["workspace::SendKeystrokes", "# p r _ # v d l"],
      "d j": [
        "workspace::SendKeystrokes",
        // up _ register delete line _ register del line (delete line current and above without yanking)
        "# u # p r _ # v d l # p r _ # v d l"
      ],
      // _ register del line _ register del line (delete line current and below without yanking)
      "d k": ["workspace::SendKeystrokes", "# p r _ # v d l # p r _ # v d l"],
      // _ register del to end of line (delete to end of line without yanking)
      "D": ["workspace::SendKeystrokes", "# p r _ # d e o l"],

      // fix broken di and da bindings
      "d i": ["workspace::SendKeystrokes", "# p r _ # p d i"],
      "d a": ["workspace::SendKeystrokes", "# p r _ # p d a"],

      "tab": ["workspace::SendKeystrokes", "i tab"],
      "shift-tab": "editor::Outdent",
      "shift-u": "vim::Redo",
      "shift-n": "vim::JoinLines",
      "space space": "file_finder::Toggle",
      "space e": "tab_switcher::Toggle",

      // ideavimrc ports
      "s": "vim::PushSneak", // flash.search stand-in: 2-char jump
      "] e": "editor::GoToDiagnostic",
      "[ e": "editor::GoToPreviousDiagnostic",

      // Git, the <leader>gh... family from .ideavimrc. Leader is space here
      // the same way it is there, so these are the literal ports:
      //   ghr  Vcs.RollbackChangedLines    -> discard the hunk under the cursor
      //   ghl  Vcs.QuickListPopupAction    -> the git panel, Zed's VCS popup
      //   ghd  VcsShowCurrentChangeMarker  -> expand the hunk's diff inline
      "space g h r": "git::Restore",
      "space g h l": "git_panel::ToggleFocus",
      "space g h d": "editor::ToggleSelectedDiffHunks",
      // no IdeaVim counterpart, but the rest of the gitsigns family the
      // prefix implies — staging and hunk navigation
      "space g h s": "git::ToggleStaged",
      "space g h b": "editor::ToggleGitBlame",
      "space g h D": "editor::ExpandAllDiffHunks",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "g shift-i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences",
      "g y": "editor::GoToTypeDefinition",
      // toggle, not Fold: Zed has no cursor-into-fold auto-expand, so
      // the same key must undo the fold (z o / z R also work)
      ", d": "editor::ToggleFold",
      // _ register delete left (backspace without yanking)
      "backspace": ["workspace::SendKeystrokes", "# p r _ d h"],
      // ...and the same rightward, for ideavimrc's `noremap <Del> "_<Del>`
      "delete": ["workspace::SendKeystrokes", "# p r _ d l"],

      // occurrence multicursor in NORMAL mode too — the visual block below
      // already has these, but ideavimrc binds them with both nmap and vmap,
      // so from normal mode they did nothing here
      "alt-L": "vim::SelectNext",
      "alt-H": "editor::UndoSelection"
    }
  },

  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "\"": ["workspace::SendKeystrokes", "S \" l v i \""],
      "'": ["workspace::SendKeystrokes", "S ' l v i '"],
      "`": ["workspace::SendKeystrokes", "S ` l v i `"],
      // "S <closing bracket>" wraps tight (no padding spaces), so no cleanup
      // dance needed — wrap, then reselect inside
      "(": ["workspace::SendKeystrokes", "S ) v i ("],
      "[": ["workspace::SendKeystrokes", "S ] v i ["],
      "{": ["workspace::SendKeystrokes", "S { l v i }"],
      "shift-s": "vim::PushAddSurrounds",

      ", r": "editor::Rename",

      // _ register delete (delete without yanking)
      "d": ["workspace::SendKeystrokes", "# p r _ d"],

      // _ register paste (paste without yanking)
      "p": ["workspace::SendKeystrokes", "# p r _ d P"],
      "P": ["workspace::SendKeystrokes", "# p r _ d P"],

      "alt-L": "vim::SelectNext",
      "alt-H": "editor::UndoSelection",

      // ideavimrc ports: indent/dedent keeping the selection
      "tab": "editor::Indent",
      "shift-tab": "editor::Outdent"
    }
  },

  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "d": ["project_panel::Delete", { "skip_prompt": false }],
      "c": "project_panel::CollapseAllEntries",
      "r": "project_panel::Rename",

      "k": "menu::SelectNext",
      "j": "menu::SelectPrevious",

      // same action as ", c" in the editor: closes the dock this panel sits
      // in, so moving the project panel to the left keeps working
      "ctrl-w": "workspace::CloseActiveDock",
      "cmd-w": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "VimControl",
    "bindings": {
      "left": "vim::WrappingLeft",
      "right": "vim::WrappingRight",
      "h": "vim::WrappingLeft",
      "l": "vim::WrappingRight"
    }
  },

  {
    "context": "Pane",
    "bindings": {
      "alt-l": "pane::ActivateNextItem",
      "alt-h": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "alt-l": ["workspace::SendKeystrokes", "escape alt-l"], // leave insert mode, then next item
      "alt-h": ["workspace::SendKeystrokes", "escape alt-h"] // leave insert mode, then previous item
    }
  }
]
