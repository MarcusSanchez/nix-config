# Ghostty on the bare-metal desktops — ~/.config/ghostty/config links
# here. The include resolves against this file's directory, which is
# why the base is linked alongside (same trap as niri's include).
config-file = ghostty.config

font-size = 12

# No titlebar at all: under niri, tabs/splits go unused (the
# compositor tiles instead), so the header is pure chrome. The old
# tabs-in-titlebar setup (gtk-titlebar-style tabs + window-decoration
# client + window-theme ghostty) is in git history if terminal tabs
# ever come back into fashion. Blur comes from niri's window-rule
# background-effect, not from here: ghostty's own background-blur
# speaks the KDE/macOS protocols, not niri's ext-background-effect.
window-decoration = none

# Windows Terminal muscle memory. Deliberate trade-offs, same ones WT
# made: performable: makes ctrl+c copy only while a selection exists
# (SIGINT otherwise); ctrl+w shadows zsh's backward-kill-word; ctrl+d
# shadows EOF (type `exit` instead); ctrl+[ shadows vim-style ESC.
keybind = ctrl+t=new_tab
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+w=close_surface
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = alt+shift+d=new_split:auto
keybind = ctrl+left_bracket=goto_split:left
keybind = ctrl+right_bracket=goto_split:right
