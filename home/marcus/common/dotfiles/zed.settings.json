// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "mouse_wheel_zoom": true,
  "cli_default_open_behavior": "existing_window",
  "agent_ui_font_size": 16.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "terminal": {
    "font_size": 14.0
  },
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 300
    }
  },
  "proxy": "",
  "semantic_tokens": "combined",
  "global_lsp_settings": {
    // one narrow rule, not the old variable taxonomy: gopls marks
    // true/false/nil readonly+defaultLibrary and Zed's built-in gopls
    // rule already paints them constant-peach — this only strips the
    // italic bleeding in from the boolean/constant.builtin syntax
    // overrides below (a TS-only look; tsserver emits no tokens for
    // its literals, so TS/TSX keeps mauve italic from syntax alone)
    "semantic_token_rules": [
      {
        "token_type": "variable",
        "token_modifiers": ["readonly", "defaultLibrary"],
        "style": ["constant"],
        "font_style": "normal"
      },
      // rust-analyzer, aligned with what the nvim catppuccin config renders
      // for the same tokens (nvim links each @lsp.type.* to a treesitter
      // capture; rust-analyzer's own token names have no link there and
      // fall through to treesitter). Zed's defaults route several of them
      // to theme styles that do not exist in that scheme: enum types via
      // the "enum" override (peach), variants via "variant" (red), macros
      // via "function.macro" (rosewater), primitives via "type" (yellow)
      { "token_type": "enum", "style": ["type"] },
      { "token_type": "enumMember", "foreground_color": "#fab387" },
      { "token_type": "macro", "style": ["function"] },
      { "token_type": "builtinType", "style": ["type.builtin"] },
      { "token_type": "character", "style": ["character"] },
      // {} in format strings: nvim leaves them string-green
      { "token_type": "formatSpecifier", "style": ["string"] },
      // Zed's rust rules send labels to the lifetime style
      { "token_type": "label", "style": ["label"] },
      // attributes: #[derive]/#[test]/#[cfg] names and derive helpers
      // (#[serde(..)]) are treesitter @function.macro pink in nvim; the
      // derived traits are types; proc-macro attributes go through
      // @lsp.type.decorator -> @attribute -> peach
      { "token_type": "builtinAttribute", "foreground_color": "#f5c2e7" },
      { "token_type": "deriveHelper", "foreground_color": "#f5c2e7" },
      { "token_type": "derive", "style": ["type"] },
      { "token_type": "decorator", "style": ["constant"] },
      // punctuation is requested from rust-analyzer (lsp block below) for
      // one token: the ":" of type annotations, which Zed's rust query
      // captures as @operator while nvim's has it as a delimiter. The
      // brackets ride along and are left transparent (an empty rule) so
      // colorize_brackets keeps painting them; "." and "::" never arrive
      // here — rust-analyzer classes them as operators, in both editors
      { "token_type": "colon", "style": ["punctuation.delimiter"] },
      { "token_type": "comma", "style": ["punctuation.delimiter"] },
      { "token_type": "semicolon", "style": ["punctuation.delimiter"] },
      { "token_type": "dot", "style": ["punctuation.delimiter"] },
      { "token_type": "angle" },
      { "token_type": "brace" },
      { "token_type": "bracket" },
      { "token_type": "parenthesis" },
      { "token_type": "attributeBracket" },
      { "token_type": "punctuation" }
    ]
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        // match nvim (LazyVim lang.go: goimports+gofumpt) and goland:
        // stricter formatting incl. stdlib imports as their own group
        "gofumpt": true
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "semanticHighlighting": {
          // off by default; on so the colon/comma/semicolon rules in
          // global_lsp_settings have tokens to act on. specialization is
          // what splits brackets out from the rest (kept transparent there)
          "punctuation": {
            "enable": true,
            "specialization": { "enable": true }
          }
        }
      }
    }
  },
  "languages": {
    "Zig": {
      "tab_size": 4
    },
    "Nix": {
      // nixd is installed system-wide on NixOS; nil isn't, and the
      // extension's auto-downloaded nil binary can't run on NixOS
      "language_servers": ["nixd", "!nil"]
    }
  },
  "wsl_connections": [
    {
      "distro_name": "NixOS",
      "user": null,
      "projects": [
        {
          "paths": [
            "/home/marcus/nix-config"
          ]
        },
        {
          "paths": [
            "/home/marcus/projects/noted"
          ]
        },
        {
          "paths": [
            "/home/marcus/projects/rustma"
          ]
        },
        {
          "paths": [
            "/home/marcus/projects/zigma"
          ]
        }
      ]
    }
  ],
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
  },
  "enable_language_server": true,
  "edit_predictions": {
    "provider": "copilot",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
    "cargo": null,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "tabs": {
    "file_icons": true,
  },
  "relative_line_numbers": "enabled",
  "base_keymap": "JetBrains",
  "vim_mode": true,
  // "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },

  "vertical_scroll_margin": 5,
  "scroll_beyond_last_line": "vertical_scroll_margin",

  "buffer_font_features": {
    "calt": false,
  },

  "extend_comment_on_newline": false,

  "preferred_line_length": 120,
  "wrap_guides": [120],

  // ported from GoLand's "M's Mocha" scheme (the source of truth for
  // syntax colors — AppData\Roaming\JetBrains\GoLand*\colors\M_s Mocha.icls).
  // Not expressible here: global-vs-local variables, exported-vs-local
  // constants (Zed's captures don't distinguish them)
  "experimental.theme_overrides": {
    // bracket-colorization cycle (colorize_brackets above), same colors
    // and order as GoLand's *_BRACKETS_RAINBOW_COLOR0-5
    "accents": [
      "#f9e2af",
      "#cba6f7",
      "#f38ba8",
      "#89b4fa",
      "#89dceb",
      "#fab387",
    ],
    "syntax": {
      "keyword": { "color": "#cba6f7", "font_style": "italic" },
      "function": { "color": "#89b4fa" },
      "function.builtin": { "color": "#89b4fa" },
      "type": { "color": "#f9e2af" },
      // the catppuccin theme ships type.builtin and type.interface italic;
      // nvim has both upright (i32 mauve, traits plain yellow)
      "type.builtin": { "color": "#cba6f7", "font_style": "normal" },
      "type.interface": { "color": "#f9e2af", "font_style": "normal" },
      // self/this: nvim's @variable.builtin, red and upright
      "variable.special": { "color": "#f38ba8", "font_style": "normal" },
      // 'a — the theme has no lifetime style at all, so these rendered as
      // plain text; nvim paints the name peach (treesitter @attribute)
      "lifetime": { "color": "#fab387" },
      "constructor": { "color": "#f9e2af" },
      "enum": { "color": "#fab387" },
      "constant": { "color": "#fab387" },
      // true/false (boolean) and null/undefined/nil (constant.builtin)
      // read as keywords, per GoLand
      "boolean": { "color": "#cba6f7", "font_style": "italic" },
      "constant.builtin": { "color": "#cba6f7", "font_style": "italic" },
      "number": { "color": "#89dceb" },
      "property": { "color": "#f38ba8" },
      "field": { "color": "#f38ba8" },
      "variable.member": { "color": "#f38ba8" },
      "variable": { "color": "#bac2de" },
      "variable.parameter": { "color": "#dabb9b" },
      "attribute": { "color": "#dabb9b" },
      "namespace": { "color": "#bac2de", "font_style": "italic" },
      // GoLand: components yellow via class-reference resolution; Zed's
      // single tag capture can't split components from <div>s, so all
      // JSX tags go yellow
      "tag": { "color": "#f9e2af" },
      "operator": { "color": "#ff6ca9" },
      "punctuation.delimiter": { "color": "#9399b2" },
      "punctuation.bracket": { "color": "#9399b2" },
      "punctuation.special": { "color": "#ff6ca9" },
    },
  },
}
