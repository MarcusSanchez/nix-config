# Ghostty, the shared base — every machine that runs it includes this
# from its platform entry file (ghostty.linux.config /
# ghostty.darwin.config, the ~/.config/ghostty/config link target).
# Live-editable like the rest of the rice: reload with ctrl+shift+,
# (cmd on the mac) or restart; drift rides the dotfiles auto-commit.

# No theme here ON PURPOSE: this base is a DEFERRED include (ghostty
# processes config-file includes after the entry's inline keys), so a
# theme set here would override the entry's own choice. Each platform
# entry names its theme instead — catppuccin on the mac, DMS's
# palette-following dankcolors on the desktop.

# Ghostty sets TERM=xterm-ghostty, which remote hosts generally don't
# have — the line editor then redraws wrong and typing comes out
# duplicated. ssh-terminfo makes Ghostty install its terminfo on the
# remote on first connect (cached; `ghostty +ssh-cache` inspects it);
# ssh-env falls back to a sane TERM where it can't.
# modules/nixos/packages.nix and modules/wsl/packages.nix ship
# ghostty.terminfo, fixing this from the other side for the fleet's own
# machines; this covers everything else.
shell-integration-features = ssh-env,ssh-terminfo

font-family = JetBrainsMono Nerd Font Mono
window-title-font-family = JetBrainsMono Nerd Font Mono
# disable ligatures
font-feature = -calt
font-feature = -liga

window-padding-balance = true
# smear adjacent cell colors into the leftover pixels (window height is
# never an exact multiple of cell height), so nvim's statusline looks
# flush with the bottom edge at any font size
window-padding-color = extend
# fresh start every launch, no macOS window/tab/split restoration —
# "never", not removed: the default follows the system-wide restore
# setting, which can still resurrect closed surfaces. Continuity of
# PLACE comes from zsh instead (omz last-working-dir in shell.nix).
window-save-state = never
confirm-close-surface = false

# the frosted-glass look is a joint effort: opacity here, blur from
# the compositor side (niri's window-rule on Linux, background-blur in
# the darwin entry)
background-opacity = 0.75

split-divider-color = #f5c2e7
cursor-color = #F5E0DC

# terminal apps don't get to raise desktop notifications (the OSC
# 9/777 forward);
# ghostty's OWN toasts stay governed by app-notifications
desktop-notifications = false

quick-terminal-position = bottom
