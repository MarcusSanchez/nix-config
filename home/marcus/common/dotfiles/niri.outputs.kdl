// Output layout, split out of niri.config.kdl because TWO niri
// instances need it: the session (which includes this file — niri
// resolves relative includes against ~/.config/niri/, where both
// files are linked) and the DMS greeter, whose launcher appends
// `include "/etc/greetd/niri_overrides.kdl"` to its own generated
// config when that file exists — modules/desktop/greeter.nix points
// it at a store copy of this one. Without that, the greeter runs
// every monitor untransformed at scale 1: sideways on the vertical
// monitor, tiny on the 4K. (The greeter copy updates on rebuild, not
// on save — only the session hot-reloads.)
//
// Multi-machine convention: outputs are keyed by connector name, and a
// block for a connector the machine doesn't have is inert — this ONE
// file serves every host; add blocks, never fork it. eDP-1 exists only
// on the laptop. On a machine with other monitors, run `niri msg
// outputs` for their connector names and add a block per monitor here
// (position/mode/scale — the commented template in niri.config.kdl
// shows the fields); until then they auto-place in connector order.
//
// 1.0 slightly small, DMS's next preset 1.25 way too big — niri takes
// arbitrary fractional scales, and wayland-native apps stay crisp via
// the fractional-scale protocol (xwayland apps may soften slightly)
output "eDP-1" {
    scale 1.1
}

// naut-dt: three monitors, left to right — DP-2 vertical, the 4K
// in the middle, DP-1 on the right. Connector-keyed, so these blocks are
// inert on the laptop (which has only eDP-1). Modes are each panel's
// maximum; y positions centre the shorter panels against the vertical
// one's 1920 logical height, so the cursor crosses at a steady height.
//
// The desk works as: side monitors hold static things (video, music),
// the 4K in the middle is the scrollable workspace. Verify the connector
// names with `niri msg outputs` after any cable change — the layout
// follows the PORT, not the panel.
// transform "90" is the rotation source. Do NOT add a
// panel_orientation kernel param alongside it: niri COMPOSES the two
// (property + transform "90" = 180°, sideways-flipped). The param
// would also serve nothing — the side connectors are boot-disabled
// (video=DP-2:d in hosts/naut-dt/monitors.nix), so plymouth
// never draws there, and plymouth-on-DP-2 is the only thing such a
// param would rotate.
output "DP-2" {
    mode "1920x1080@179.998"
    transform "90"
    scale 1
    position x=0 y=0
}

output "DP-3" {
    mode "3840x2160@240.000"
    scale 1.75
    position x=1080 y=343
}

// x=3275, not 3274: at scale 1.75 the 4K's logical width is
// 3840/1.75 = 2194.29, so it really ends at 3274.29 — asking for 3274
// overlaps by a fraction and niri silently falls back to automatic
// placement (which is how the y offset gets lost).
output "DP-1" {
    mode "2560x1440@320.001"
    scale 1.25
    position x=3275 y=384
}
