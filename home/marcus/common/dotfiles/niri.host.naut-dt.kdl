// Host-specific niri config for naut-dt. niri.config.kdl
// includes the stable name "niri.host.kdl", and desktop/niri.nix
// links that name at ~/.config/niri to THIS file when the hostname
// matches — one shared config, per-host tails. Live-editable like
// the rest: niri hot-reloads on save.
//
// Per-app default column widths for the desk's wide monitors; a host
// without a tail of its own keeps the global 2/3 for everything.
// Sizes apply at open — resizing after is unaffected.
// Find an app's id with `niri msg windows` while it's running.

window-rule {
    match app-id="spotify"
    default-column-width { proportion 1.0; }
}

// the editors take (nearly) the whole working strip, same as Mod+F
window-rule {
    match app-id="dev.zed.Zed"
    match app-id="^jetbrains-"
    default-column-width { proportion 0.95; }
}

window-rule {
    match app-id="com.mitchellh.ghostty"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="^zen"
    default-column-width { proportion 1.0; }
}

// the live spaceman on the 4K. Layer "bottom", not "background":
// DMS's wallpaper surface maps seconds after session start and lands
// on top of anything in the background layer (the boot race that made
// the video invisible) — bottom sits above every background surface
// and below all windows, deterministically. The static astronaut
// stays underneath as the crash/fallback frame. NVDEC decodes; ~6% of
// one core, 8% GPU.
spawn-at-startup "mpvpaper" "-l" "bottom" "-o" "no-audio loop hwdec=auto" "DP-3" "/home/marcus/Pictures/Wallpapers/live/spaceman.mp4"
// only the middle monitor animates. The sides wear static comet
// stills captured from the same loop (home/marcus/nixos/assets/
// space-stars-*.jpg) — deliberately not derived side videos: mosaic
// seams wide enough to hide moving comets eat too much frame, and
// three 4K-class decoders for two accent panels buy little over
// stills from the identical star field. Painted by swaybg per output
// as the instant base layer; DMS's own wallpaper layer maps over
// these with the same pixels (from session state) once the shell is
// up.
spawn-at-startup "swaybg" "-o" "DP-1" "-m" "fill" "-i" "/home/marcus/Pictures/Wallpapers/space-stars-2560x1440.jpg"
spawn-at-startup "swaybg" "-o" "DP-2" "-m" "fill" "-i" "/home/marcus/Pictures/Wallpapers/space-stars-1080x1920.jpg"
