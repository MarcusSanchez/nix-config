// Host-specific niri config for hero — niri.config.kdl includes the
// stable name niri.host.kdl, which desktop/niri.nix links at this file
// per hostname; the file exists so that include resolves (a new
// desktop host must commit its tail BEFORE the first switch or HM
// links against nothing). Output blocks belong in niri.outputs.kdl,
// keyed by connector.

// the animated middle layer, replayed from the last look's recorded
// choice (mpvpaper:toggle persists on/off — see niri.nix). The video
// itself (~/Pictures/Wallpapers/live/spaceman.mp4) is machine-local,
// NOT in the repo — until a copy lands at that path, an "on" replay
// starts mpvpaper which exits instantly: harmless, and the static
// wallpaper shows.
spawn-at-startup "sh" "-c" "mpvpaper:toggle \"$(cat ~/.local/state/desk-mpvpaper 2>/dev/null || echo off)\""

// music takes the portrait's whole width (it lands there via the
// open-on-output rule in niri.config.kdl); a single window in the
// column already gets the full height
window-rule {
    match app-id="spotify"
    default-column-width { proportion 1.0; }
}
