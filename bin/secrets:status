#!/usr/bin/env bash
# Are the three secret-fed tools actually authenticated. Reads the fly token
# from /run/secrets itself, so it works in any shell — the interactive
# export only exists in login shells. All three run even if one fails;
# nonzero exit if any did. timeout is GNU coreutils — in the NixOS base
# system but absent on a stock mac — so the fly hang-guard is conditional.
set -u
fail=0
echo "── gh"
gh auth status || fail=1
echo "── atuin"
atuin status 2>/dev/null | grep '^Username' || {
  echo "not logged in"
  fail=1
}
echo "── fly"
# fly_token lives in super.yaml, which only trusted machines decrypt — absence
# there is the configured state, not a failure.
# </dev/null: with no token fly offers an interactive sign-in and hangs
# on the prompt; with no stdin it errors out immediately instead
if [ ! -r /run/secrets/fly_token ]; then
  echo "not provisioned on this tier"
elif command -v timeout >/dev/null; then
  FLY_API_TOKEN="$(cat /run/secrets/fly_token)" timeout 15 fly auth whoami </dev/null || fail=1
else
  FLY_API_TOKEN="$(cat /run/secrets/fly_token)" fly auth whoami </dev/null || fail=1
fi
exit "$fail"
