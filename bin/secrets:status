#!/usr/bin/env bash
# Are the secret-fed tools actually authenticated. Reads the fly token
# from /run/secrets itself: this script never sources hm-session-vars,
# so the FLY_API_TOKEN export an interactive shell carries is not
# visible here. croc has no login to check — its CROC_SECRET is a static
# code phrase — so only the presence of its secret file is reported.
# Every check runs even if one fails; nonzero exit if any did. timeout is
# GNU coreutils — in the NixOS base system but absent on a stock mac — so
# the hang-guards are conditional.
set -u
fail=0
if command -v timeout >/dev/null; then t="timeout 15"; else t=""; fi
echo "── gh"
gh auth status || fail=1
echo "── atuin"
# shellcheck disable=SC2086
$t atuin status 2>/dev/null | grep '^Username' || {
  echo "not logged in"
  fail=1
}
echo "── fly"
# fly_token lives in super.yaml, which only trusted machines decrypt — absence
# there is the configured state, not a failure.
# </dev/null: with no token fly offers an interactive sign-in and hangs
# on the prompt; with no stdin it errors out immediately instead
if [ ! -r /run/secrets/fly_token ]; then
  echo "not provisioned on this tier"
else
  # shellcheck disable=SC2086
  FLY_API_TOKEN="$(cat /run/secrets/fly_token)" $t fly auth whoami </dev/null || fail=1
fi
echo "── croc"
if [ -r /run/secrets/croc_secret ]; then
  echo "secret present"
else
  echo "secret missing"
  fail=1
fi
exit "$fail"
