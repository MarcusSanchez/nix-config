#!/usr/bin/env bash
# sops on a tier file: bare = secrets.yaml (lower tier, every box),
# `secrets:edit super` = super.yaml (trusted machines only). Editing super
# works only where a recipient identity lives — bedroom-wsl or the mac.
case "${1:-}" in
"") f=secrets.yaml ;;
super) f=super.yaml ;;
*)
  echo "usage: secrets:edit [super]" >&2
  exit 2
  ;;
esac
exec sops "$(git rev-parse --show-toplevel)/secrets/$f"
