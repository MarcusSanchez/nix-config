#!/usr/bin/env bash
# The same gate CI runs, locally: format, lint, evaluate every host.
set -e
cd "$(git rev-parse --show-toplevel)"
nix fmt
statix check .
# hardware-configuration.nix files are generated (nixos-generate-config)
# and not held to repo style — statix.toml ignores them for the same reason
deadnix --fail \
  --exclude hosts/tuf/hardware-configuration.nix \
            hosts/bedroom-nixos/hardware-configuration.nix \
  -- .
nix flake check
# flake check never touches darwinConfigurations — evaluate them the
# same enumerated way CI does (a hostname rename broke a named eval once)
nix eval --raw '.#darwinConfigurations' --apply \
  'cfgs: builtins.concatStringsSep "\n" (map (n: "${n}: ${cfgs.${n}.system.drvPath}") (builtins.attrNames cfgs))'
echo
