#!/usr/bin/env bash
# The same gate CI runs, locally: format, lint, evaluate every host.
set -e
cd "$(git rev-parse --show-toplevel)"
nix fmt
statix check .
# CLAUDE.md's hand-maintained file map, gated in BOTH directions and
# scoped to the map section so prose can't vouch for a file. Forward:
# every tracked .nix file's full basename must appear in the map (a new
# file or rename can't be forgotten). Reverse: every .nix token the map
# mentions must resolve to a tracked file (a rename can't leave a
# corpse — the failure mode that actually happened).
mapsec=$(sed -n '/^## File map/,/^## Constraints/p' CLAUDE.md)
fail=0
while IFS= read -rd '' f; do
  grep -qF "$(basename "$f")" <<<"$mapsec" \
    || { echo "CLAUDE.md file map does not mention: $f" >&2; fail=1; }
done < <(git ls-files -z '*.nix')
while IFS= read -r name; do
  git ls-files '*.nix' | grep -qE "(^|/)$(basename "$name")\$" \
    || { echo "CLAUDE.md file map mentions a .nix file that does not exist: $name" >&2; fail=1; }
done < <(tr -c 'A-Za-z0-9._/-' '\n' <<<"$mapsec" | grep -E '[A-Za-z0-9_-]\.nix$' | sort -u)
# ...and the same reverse pass over the whole README (it has no map
# section to scope to). CLAUDE.md outside the map stays UNgated on
# purpose: its constraints cite git-history paths (zig.nix) that no
# longer exist and shouldn't.
while IFS= read -r name; do
  git ls-files '*.nix' | grep -qE "(^|/)$(basename "$name")\$" \
    || { echo "README.md mentions a .nix file that does not exist: $name" >&2; fail=1; }
# tokenize, then require .nix at token END — names that merely CONTAIN
# ".nix" (nixosConfigurations.nixos, the Determinate service) never
# produce a token ending in it, so no lookahead and no GNU-only grep.
# The one whitelist entry is the stock file on a fresh image — external.
done < <(tr -c 'A-Za-z0-9._/-' '\n' < README.md | grep -E '[A-Za-z0-9_-]\.nix$' | sort -u \
  | grep -vE '(^|/)configuration\.nix$')
[ "$fail" = 0 ]
# hardware-configuration.nix files are generated (nixos-generate-config)
# and not held to repo style — statix.toml ignores them for the same reason
deadnix --fail --exclude hosts/*/hardware-configuration.nix -- .
nix flake check
# flake check never touches darwinConfigurations — evaluate them the
# same enumerated way CI does (a hostname rename broke a named eval once)
nix eval --raw '.#darwinConfigurations' --apply \
  'cfgs: builtins.concatStringsSep "\n" (map (n: "${n}: ${cfgs.${n}.system.drvPath}") (builtins.attrNames cfgs))'
echo
