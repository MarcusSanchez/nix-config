#!/usr/bin/env bash
# The inverse of age:place: strip this machine of everything that lets it
# act as marcus, so whoever uses the box next can't reach the CLIs. That is
# more than the two key files — /run/secrets.d also holds sops-nix's own
# working copy of the age key plus the rendered gh hosts.yml, and atuin/rbw
# keep sessions (and synced history / a local vault copy) that would outlive
# the key. The config itself stays: the box still builds and switches;
# setupSecrets just fails harmlessly until age:place re-arms it.
set -euo pipefail

echo "removes the age key, /run/secrets, and every CLI session on this box."
printf "drop? [y/N] "
read -r a
case "$a" in y | Y) ;; *)
  echo "aborted, nothing touched"
  exit 1
  ;;
esac

# sessions first: atuin's hub session lives server-side in meta.db, so it
# must be revoked, not just deleted
atuin logout >/dev/null 2>&1 && echo "atuin: logged out" || echo "atuin: no session"
rbw stop-agent 2>/dev/null || true

# synced/derived state: atuin's history.db holds commands synced from EVERY
# machine, rbw's data dir is a local vault copy, ~/.fly carries tokens
# flyctl refreshed on its own (both path variants — Linux XDG and mac)
rm -rf "$HOME/.local/share/atuin" \
  "$HOME/.local/share/rbw" "$HOME/.cache/rbw" \
  "$HOME/Library/Application Support/rbw" "$HOME/Library/Caches/rbw" \
  "$HOME/.fly"

# gh's state file is a symlink into /run/secrets/rendered — about to dangle
rm -f "$HOME/.config/gh/hosts.yml"

# decrypted values + sops-nix's key copy, then the identity itself
sudo rm -rf /run/secrets /run/secrets.d /var/lib/sops-nix
rm -f "$HOME/.config/sops/age/keys.txt"

for p in /var/lib/sops-nix/key.txt /run/secrets "$HOME/.config/sops/age/keys.txt"; do
  if [ -e "$p" ] || [ -L "$p" ]; then
    echo "still present: $p" >&2
    exit 1
  fi
done

echo "dropped. what this can't reach:"
echo "  - shells already open may hold FLY_API_TOKEN/CROC_SECRET — close them"
echo "  - the box is still on the tailnet (can ssh to your machines):"
echo "      sudo tailscale logout   # only if it should lose that too"
echo "verify:  secrets:status   (expect all three to fail)"
echo "re-arm:  age:place, then a switch"
