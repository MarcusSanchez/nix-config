#!/usr/bin/env bash
# The inverse of age:place: strip this machine of everything that lets it
# act as marcus, so whoever uses the box next can't reach the CLIs. That is
# more than the two key files — /run/secrets.d also holds sops-nix's own
# working copy of the age key plus the rendered gh hosts.yml, and atuin
# keeps a session (and synced history) that would outlive the key. rbw is
# deliberately only LOCKED, not logged out: the on-disk vault is ciphertext
# that needs the master password, and keeping it means re-arming with
# age:place asks for that one password instead of a full re-login. The
# config itself stays: the box still builds and switches; setupSecrets just
# fails harmlessly until age:place re-arms it.
set -euo pipefail

echo "removes the age key, /run/secrets, and every CLI session on this box."
printf "drop? [y/N] "
read -r a
case "$a" in y | Y) ;; *)
  echo "aborted, nothing touched"
  exit 1
  ;;
esac

# sessions first: atuin's hub session lives server-side in meta.db, so it
# must be revoked, not just deleted
atuin logout >/dev/null 2>&1 && echo "atuin: logged out" || echo "atuin: no session"
# rbw: the unlocked keys exist only in the agent's memory — killing it IS
# the lock. A fresh agent starts locked and pinentry-prompts for the master
# password, so the vault that stays on disk is inert without it.
rbw stop-agent 2>/dev/null || true
echo "rbw: locked (vault kept; master password required to unlock)"

# synced/derived state: atuin's history.db holds commands synced from EVERY
# machine, ~/.fly carries tokens flyctl refreshed on its own
rm -rf "$HOME/.local/share/atuin" "$HOME/.fly"

# gh's state file is a symlink into /run/secrets/rendered — about to dangle
rm -f "$HOME/.config/gh/hosts.yml"

# decrypted values + sops-nix's key copy. On Linux /run/secrets.d is a
# plain dir on tmpfs; on darwin it's a mounted ramdisk — rm empties it but
# the mount point stays "Resource busy", and diskutil won't chase the
# /run -> /private/var/run symlink, so eject by device instead. Possibly
# SEVERAL devices: sops-nix detects an existing ramdisk by a marker file
# (sops-nix-secretfs) that emptying deletes, so any switch run between a
# drop and a re-arm stacks a fresh ramdisk on the mount point. Eject the
# top layer until none remain; the next activation remounts cleanly.
sudo rm -rf /run/secrets
if ! sudo rm -rf /run/secrets.d 2>/dev/null; then
  while dev=$(mount | awk '$3 ~ /\/run\/secrets\.d$/ { d = $1 } END { print d }') && [ -n "$dev" ]; do
    sudo diskutil eject "$dev" >/dev/null
  done
  sudo rm -rf /run/secrets.d
fi

# the identity itself: machine copy and editing copy
sudo rm -rf /var/lib/sops-nix
rm -f "$HOME/.config/sops/age/keys.txt"

for p in /var/lib/sops-nix/key.txt /run/secrets "$HOME/.config/sops/age/keys.txt"; do
  if [ -e "$p" ] || [ -L "$p" ]; then
    echo "still present: $p" >&2
    exit 1
  fi
done

echo "dropped. what this can't reach:"
echo "  - shells already open may hold FLY_API_TOKEN/CROC_SECRET — close them"
echo "  - the box is still on the tailnet (can ssh to your machines):"
echo "      sudo tailscale logout   # only if it should lose that too"
echo "verify:  secrets:status   (expect all three to fail)"
echo "re-arm:  age:place, then a switch"
